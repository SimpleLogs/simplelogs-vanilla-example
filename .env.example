# Your SimpleLogs client key, from Settings -> API Keys in the dashboard.
#
# There is no build step here, so this file is only a note to yourself: paste
# the key straight into the data-client-key attribute in public/index.html.
#
# The client key is public by design and origin-locked in the dashboard. The
# server key is a different value and must never appear in a page.
SIMPLELOGS_CLIENT_KEY=ck_replace_me
